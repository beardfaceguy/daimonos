#!/bin/sh
# Resync derived indexes. Called by post-commit, post-merge and post-checkout —
# the three points at which this checkout's content changes.
#
# One consumer:
#
#   repowise -> .repowise/   docs, search, git signals, and the graph KGL indexes
#
# graphify used to be refreshed here too, because KGL read its graph.json. #1291
# moved KGL onto a repowise-backed substrate, so nothing consumes graphify's
# output automatically any more. It remains a *supported* substrate — the code
# and the `substrate:"graphify"` request path are intact — but refreshing it on
# every commit was pure cost once KGL stopped reading it: ~5s per commit, 16 MB
# on disk, and a shrink guard that refuses to rebuild whenever a commit deletes
# a public symbol, silently, until someone runs `graphify update . --force` by
# hand. Anyone who wants the fallback runs that one command. See
# docs/adr/013-repowise-as-kgl-substrate.md.
#
# The index is gitignored, so nothing here is ever staged — that was the
# defect in the pre-commit block this replaces, which `git add`-ed a 6 MB
# graph.json into every commit and broke `git checkout`.
#
# Lives in .git-hooks/ because this repo sets core.hooksPath=.git-hooks;
# anything under .git/hooks/ is never executed here.
#
# Never blocks: backgrounded, self-skipping, always exits 0. These indexes are a
# convenience and must not be able to fail a commit, a pull, or a checkout.

index_sync() {
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || return 0

  # Worktrees have no .repowise/, so they skip. That is correct, not a gap:
  # this checkout is the indexed tree. A worktree branch reaches the index when
  # it merges and this checkout pulls, which post-merge covers.
  [ -d "$ROOT/.repowise" ] || return 0

  TRIGGER="${1:-unknown}"
  LOG="$ROOT/.repowise/.update.log"

  HEAD_SHA=$(git rev-parse HEAD 2>/dev/null) || HEAD_SHA=""
  {
    printf '\n--- %s hook fired at %s for HEAD %s ---\n' \
      "$TRIGGER" "$(date 2>/dev/null)" "$HEAD_SHA"
  } >> "$LOG" 2>&1 || true

  (
    cd "$ROOT" || exit 0

    if [ -d "$ROOT/.repowise" ]; then
      if command -v repowise >/dev/null 2>&1; then
        repowise update >> "$LOG" 2>&1
      elif command -v uv >/dev/null 2>&1; then
        uv run repowise update >> "$LOG" 2>&1
      fi
    fi

  ) &

  return 0
}
