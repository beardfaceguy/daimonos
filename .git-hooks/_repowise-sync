#!/bin/sh
# Resync the repowise index. Sourced/called by post-commit, post-merge and
# post-checkout — the three points at which the indexed working tree changes.
#
# Why three hooks and not just post-commit: the index tracks ONE working tree,
# the main checkout. Its content changes on a direct commit here, on `git pull`
# (post-merge), and on a branch switch (post-checkout). Wiring only post-commit
# left the common case uncovered — four PRs merged and pulled in a single day
# while the index sat on a stale commit, because a pull is not a commit.
#
# Why the `.repowise` guard stays: `git rev-parse --git-common-dir` would let a
# worktree find the main checkout, but that does not make the work useful. The
# main checkout sits on master while worktrees sit on feature branches, so a
# worktree commit does not change the indexed tree — resolving to it would just
# spend ~1s per commit re-confirming that master is unchanged. A worktree
# branch reaches the index when it merges and this checkout pulls, which is
# precisely what post-merge now covers.
#
# Lives in .git-hooks/ because this repo sets core.hooksPath=.git-hooks;
# anything under .git/hooks/ is never executed here.
#
# Never blocks: backgrounded, self-skipping, and always exits 0. The index is a
# convenience, and a convenience must not be able to fail a commit or a pull.

repowise_sync() {
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -d "$ROOT/.repowise" ] || return 0

  HEAD_SHA=$(git rev-parse HEAD 2>/dev/null) || HEAD_SHA=""
  TS=$(date +%s 2>/dev/null) || TS=""
  if [ -n "$TS" ]; then
    printf '{"target_commit":"%s","queued_at":%s,"trigger":"%s"}\n' \
      "$HEAD_SHA" "$TS" "${1:-unknown}" \
      > "$ROOT/.repowise/.update.queued" 2>/dev/null || true
  fi

  LOG="$ROOT/.repowise/.update.log"
  {
    printf '\n--- %s hook fired at %s for HEAD %s ---\n' \
      "${1:-unknown}" "$(date 2>/dev/null)" "$HEAD_SHA"
  } >> "$LOG" 2>&1 || true

  (
    cd "$ROOT" || exit 0
    if command -v repowise >/dev/null 2>&1; then
      repowise update >> "$LOG" 2>&1
    elif command -v uv >/dev/null 2>&1; then
      uv run repowise update >> "$LOG" 2>&1
    fi
  ) &

  return 0
}
