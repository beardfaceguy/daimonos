#!/usr/bin/env bash
# Lint gate added by codeJung cj-setup-check
# Catches deterministic bugs before they reach the LLM review.
# Remove a tool check here if it's not applicable to this repo.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

if command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff..."
  ruff check . --select F,E7 --output-format=concise || exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
  echo "pre-commit: shellcheck..."
  # Discover tracked shell scripts at commit time. Use NUL-delimited output +
  # xargs -0 so paths containing spaces are passed correctly.
  git ls-files -z '*.sh' '*.bash' | xargs -0 -r shellcheck --severity=error || exit 1
fi

# eslint only applies when the repo actually has a JS/TS lint config. daimonos
# is Rust-only, so without this guard `npx eslint .` fails on a missing config
# and blocks every commit. Self-skips here; runs if a config is ever added.
have_eslint_config() {
  [ -f eslint.config.js ] || [ -f eslint.config.mjs ] || [ -f eslint.config.cjs ] ||
    [ -f .eslintrc ] || [ -f .eslintrc.js ] || [ -f .eslintrc.cjs ] ||
    [ -f .eslintrc.json ] || [ -f .eslintrc.yml ] || [ -f .eslintrc.yaml ]
}
if command -v npx >/dev/null 2>&1 && have_eslint_config; then
  echo "pre-commit: eslint..."
  npx eslint --max-warnings=0 . || exit 1
fi

# Guard cargo clippy the same way as ruff/shellcheck: skip on environments
# without cargo (CI images, non-Rust contributors, doc-only commits).
if command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo clippy..."
  cargo clippy --all-targets -- -D warnings || exit 1
fi

# ── Security gates ───────────────────────────────────────────────────────────
# gitleaks: scan staged diff for secrets (API keys, tokens, credentials).
# Install: brew install gitleaks  |  https://github.com/gitleaks/gitleaks/releases
if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks..."
  gitleaks git --pre-commit --redact --staged --verbose || exit 1
fi

# semgrep: multi-language SAST — catches injection, auth, and unsafe-API patterns.
# Install: pip install semgrep  |  brew install semgrep
if command -v semgrep >/dev/null 2>&1; then
  echo "pre-commit: semgrep..."
  # --jobs 1: avoid io_uring parallel pool failures on some Linux kernel configs
  semgrep scan --config auto --error --quiet --jobs 1 || exit 1
fi

# osv-scanner: flag Cargo dependencies with known CVEs or supply-chain compromises.
# Install: go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest
#          https://github.com/google/osv-scanner/releases
if command -v osv-scanner >/dev/null 2>&1; then
  echo "pre-commit: osv-scanner..."
  osv-scanner scan source --recursive --verbosity=error . || exit 1
fi

echo "pre-commit: lint gate passed."

# ── Update knowledge graph (graphify) ────────────────────────────────────────
# Mirrors codeJung/.hooks/pre-commit: incrementally re-extract the code files
# staged in this commit, then stage the regenerated graph so graphify-out/ stays
# in lockstep with the source. Best-effort and self-skipping — never blocks a
# commit on graph tooling. Bypass with SKIP_GRAPHIFY=1.
if [[ "${SKIP_GRAPHIFY:-0}" == "1" ]]; then
  echo "pre-commit: graphify update skipped (SKIP_GRAPHIFY=1)."
elif [[ ! -f "$REPO_ROOT/graphify-out/graph.json" ]]; then
  echo "pre-commit: graphify-out/graph.json not found — run /graphify to build initial graph."
elif [[ ! -f "$REPO_ROOT/graphify-out/.graphify_python" ]]; then
  echo "pre-commit: .graphify_python missing — skipping graph update." >&2
else
  echo "pre-commit: updating knowledge graph..."
  GRAPHIFY_PYTHON="$(cat "$REPO_ROOT/graphify-out/.graphify_python")"

  # Code files staged for this commit (added/copied/modified/renamed).
  STAGED_CODE="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(py|sh|ts|js|go|rs|java|rb|cs|cpp|c)$' || true)"

  if [[ -z "$STAGED_CODE" ]]; then
    echo "pre-commit: no code file changes — skipping graph update."
  else
    FILE_COUNT=$(echo "$STAGED_CODE" | wc -l | tr -d ' ')
    echo "pre-commit: re-extracting $FILE_COUNT changed code file(s)..."

    cd "$REPO_ROOT"

    # Write the staged file list to a temp file so $REPO_ROOT and individual
    # filenames are never shell-interpolated into the Python -c string — avoids
    # SyntaxError or code injection from paths containing quotes, backslashes,
    # $, or triple-quotes.
    GRAPHIFY_STAGED_LIST="$(mktemp)"
    GRAPHIFY_REPO_FILE="$(mktemp)"
    printf '%s\n' "$REPO_ROOT" > "$GRAPHIFY_REPO_FILE"
    printf '%s\n' "$STAGED_CODE" > "$GRAPHIFY_STAGED_LIST"
    trap 'rm -f "$GRAPHIFY_STAGED_LIST" "$GRAPHIFY_REPO_FILE"' EXIT

    # Run the incremental update; capture its exit status via a sentinel file
    # so the pipe through sed (for indented output) does not swallow failures.
    # A plain `|| GRAPHIFY_OK=1` after a pipeline applies to the last command
    # (sed), not to the python invocation.
    GRAPHIFY_OK_FILE="$(mktemp)"
    echo "0" > "$GRAPHIFY_OK_FILE"
    trap 'rm -f "$GRAPHIFY_STAGED_LIST" "$GRAPHIFY_REPO_FILE" "$GRAPHIFY_OK_FILE"' EXIT
    {
      "$GRAPHIFY_PYTHON" -c "
import json, sys
from graphify.extract import extract
from graphify.build import build_merge
from graphify.cluster import cluster, score_all
from graphify.analyze import god_nodes, surprising_connections, suggest_questions
from graphify.report import generate
from graphify.export import to_json
from pathlib import Path

repo = Path(open(sys.argv[1]).read().strip())
staged = [l for l in open(sys.argv[2]).read().splitlines() if l.strip()]
code_files = [repo / f for f in staged if (repo / f).exists()]
if not code_files:
    print('pre-commit: no valid staged files found.')
    sys.exit(0)

ast_result = extract(code_files, cache_root=repo)
new_extraction = {'nodes': ast_result['nodes'], 'edges': ast_result['edges'], 'hyperedges': [], 'input_tokens': 0, 'output_tokens': 0}

G = build_merge([new_extraction], graph_path=str(repo / 'graphify-out/graph.json'))

labels_path = repo / 'graphify-out/.graphify_labels.json'
labels = json.loads(labels_path.read_text(encoding='utf-8')) if labels_path.exists() else {}
labels = {int(k): v for k, v in labels.items()}
communities = cluster(G)
for cid in communities:
    if cid not in labels:
        labels[cid] = f'Community {cid}'
cohesion = score_all(G, communities)

gods = god_nodes(G)
surprises = surprising_connections(G, communities)
questions = suggest_questions(G, communities, labels)
detection = {'total_files': G.number_of_nodes(), 'total_words': 0, 'files': {}}
report = generate(G, communities, cohesion, labels, gods, surprises, detection, {'input': 0, 'output': 0}, '.', suggested_questions=questions)
(repo / 'graphify-out/GRAPH_REPORT.md').write_text(report, encoding='utf-8')
to_json(G, communities, str(repo / 'graphify-out/graph.json'))
(repo / 'graphify-out/.graphify_labels.json').write_text(json.dumps({str(k): v for k, v in labels.items()}, ensure_ascii=False), encoding='utf-8')
print(f'pre-commit: graph updated — {G.number_of_nodes()} nodes, {G.number_of_edges()} edges')
" "$GRAPHIFY_REPO_FILE" "$GRAPHIFY_STAGED_LIST"; echo "$?" > "$GRAPHIFY_OK_FILE"
    } 2>&1 | sed 's/^/  /'
    GRAPHIFY_OK="$(cat "$GRAPHIFY_OK_FILE")"

    if [[ "$GRAPHIFY_OK" -ne 0 ]]; then
      echo "pre-commit: graphify update failed — skipping graph staging." >&2
    else
      # Stage the artifacts only when the update succeeded.
      git add "$REPO_ROOT/graphify-out/graph.json" \
              "$REPO_ROOT/graphify-out/GRAPH_REPORT.md" \
              "$REPO_ROOT/graphify-out/.graphify_labels.json" 2>/dev/null || true
      echo "pre-commit: graphify-out/ changes staged."
    fi
  fi
fi
