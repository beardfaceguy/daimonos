#!/usr/bin/env bash
# Lint gate added by codeJung cj-setup-check
# Catches deterministic bugs before they reach the LLM review.
# Remove a tool check here if it's not applicable to this repo.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

if command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff..."
  ruff check . --select F,E7 --output-format=concise || exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
  echo "pre-commit: shellcheck..."
  # Discover tracked shell scripts at commit time. Use NUL-delimited output +
  # xargs -0 so paths containing spaces are passed correctly.
  git ls-files -z '*.sh' '*.bash' | xargs -0 -r shellcheck --severity=error || exit 1
fi

# eslint only applies when the repo actually has a JS/TS lint config. daimonos
# is Rust-only, so without this guard `npx eslint .` fails on a missing config
# and blocks every commit. Self-skips here; runs if a config is ever added.
have_eslint_config() {
  [ -f eslint.config.js ] || [ -f eslint.config.mjs ] || [ -f eslint.config.cjs ] ||
    [ -f .eslintrc ] || [ -f .eslintrc.js ] || [ -f .eslintrc.cjs ] ||
    [ -f .eslintrc.json ] || [ -f .eslintrc.yml ] || [ -f .eslintrc.yaml ]
}
if command -v npx >/dev/null 2>&1 && have_eslint_config; then
  echo "pre-commit: eslint..."
  npx eslint --max-warnings=0 . || exit 1
fi

# Guard cargo clippy the same way as ruff/shellcheck: skip on environments
# without cargo (CI images, non-Rust contributors, doc-only commits).
if command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo clippy..."
  cargo clippy --all-targets -- -D warnings || exit 1
fi

# ── Security gates ───────────────────────────────────────────────────────────
# gitleaks: scan staged diff for secrets (API keys, tokens, credentials).
# Install: brew install gitleaks  |  https://github.com/gitleaks/gitleaks/releases
if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks..."
  gitleaks git --pre-commit --redact --staged --verbose || exit 1
fi

# semgrep: multi-language SAST — catches injection, auth, and unsafe-API patterns.
# Install: pip install semgrep  |  brew install semgrep
if command -v semgrep >/dev/null 2>&1; then
  echo "pre-commit: semgrep..."
  # --jobs 1: avoid io_uring parallel pool failures on some Linux kernel configs
  semgrep scan --config auto --error --quiet --jobs 1 || exit 1
fi

# osv-scanner: flag Cargo dependencies with known CVEs or supply-chain compromises.
# Install: go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest
#          https://github.com/google/osv-scanner/releases
if command -v osv-scanner >/dev/null 2>&1; then
  echo "pre-commit: osv-scanner..."
  osv-scanner scan source --recursive --verbosity=error . || exit 1
fi

echo "pre-commit: lint gate passed."

# ── Knowledge graph ──────────────────────────────────────────────────────────
# The graphify update block that used to live here is gone. It regenerated a
# 6 MB graph.json and `git add`-ed it into every commit, which meant:
#   - the generated artifact was tracked, so routine `git checkout` failed with
#     "local changes would be overwritten" on a file no human had edited;
#   - it gated on graphify-out/.graphify_python, which is untracked and so
#     absent in every worktree — every commit made from a worktree printed
#     "skipping graph update" and nobody read it. The graph silently went
#     7 days and 61 commits stale while still being queried as authoritative.
#
# Replaced by repowise, whose index resyncs from .git-hooks/post-commit:
# machine-local (.repowise/, gitignored), nothing staged, cannot block a
# commit, and ~1.5s incrementally. Every repowise response also carries the
# indexed commit and warns when it diverges from HEAD, so a stale index
# announces itself instead of being trusted.
