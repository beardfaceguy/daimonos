#!/usr/bin/env bash
# Lint gate added by codeJung cj-setup-check
# Catches deterministic bugs before they reach the LLM review.
# Remove a tool check here if it's not applicable to this repo.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

if command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff..."
  ruff check . --select F,E7 --output-format=concise || exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
  echo "pre-commit: shellcheck..."
  # Discover tracked shell scripts at commit time. Use NUL-delimited output +
  # xargs -0 so paths containing spaces are passed correctly.
  git ls-files -z '*.sh' '*.bash' | xargs -0 -r shellcheck --severity=error || exit 1
fi

# eslint only applies when the repo actually has a JS/TS lint config. daimonos
# is Rust-only, so without this guard `npx eslint .` fails on a missing config
# and blocks every commit. Self-skips here; runs if a config is ever added.
have_eslint_config() {
  [ -f eslint.config.js ] || [ -f eslint.config.mjs ] || [ -f eslint.config.cjs ] ||
    [ -f .eslintrc ] || [ -f .eslintrc.js ] || [ -f .eslintrc.cjs ] ||
    [ -f .eslintrc.json ] || [ -f .eslintrc.yml ] || [ -f .eslintrc.yaml ]
}
if command -v npx >/dev/null 2>&1 && have_eslint_config; then
  echo "pre-commit: eslint..."
  npx eslint --max-warnings=0 . || exit 1
fi

# Guard cargo clippy the same way as ruff/shellcheck: skip on environments
# without cargo (CI images, non-Rust contributors, doc-only commits).
if command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo clippy..."
  cargo clippy --all-targets -- -D warnings || exit 1
fi

# ── Security gates ───────────────────────────────────────────────────────────
# gitleaks: scan staged diff for secrets (API keys, tokens, credentials).
# Install: brew install gitleaks  |  https://github.com/gitleaks/gitleaks/releases
if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks..."
  gitleaks git --pre-commit --redact --staged --verbose || exit 1
fi

# semgrep: multi-language SAST — catches injection, auth, and unsafe-API patterns.
# Install: pip install semgrep  |  brew install semgrep
if command -v semgrep >/dev/null 2>&1; then
  echo "pre-commit: semgrep..."
  # --jobs 1: avoid io_uring parallel pool failures on some Linux kernel configs
  semgrep scan --config auto --error --quiet --jobs 1 || exit 1
fi

# osv-scanner: flag Cargo dependencies with known CVEs or supply-chain compromises.
# Install: go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest
#          https://github.com/google/osv-scanner/releases
if command -v osv-scanner >/dev/null 2>&1; then
  echo "pre-commit: osv-scanner..."
  osv-scanner scan source --recursive --verbosity=error . || exit 1
fi

echo "pre-commit: lint gate passed."

# ── Update knowledge graph (graphify) ────────────────────────────────────────
# Re-extract the full code corpus with graphify's canonical update path, then
# stage the regenerated graph so graphify-out/ stays in lockstep with source.
# A staged-file build_merge is not equivalent to a full extraction: global
# dedup can drop nodes, trip the shrink guard, and leave report/labels out of
# sync with graph.json (Vikunja #981). Best-effort and self-skipping — never
# blocks a commit on graph tooling. Bypass with SKIP_GRAPHIFY=1.
if [[ "${SKIP_GRAPHIFY:-0}" == "1" ]]; then
  echo "pre-commit: graphify update skipped (SKIP_GRAPHIFY=1)."
elif [[ ! -f "$REPO_ROOT/graphify-out/graph.json" ]]; then
  echo "pre-commit: graphify-out/graph.json not found — run /graphify to build initial graph."
elif [[ ! -f "$REPO_ROOT/graphify-out/.graphify_python" ]]; then
  echo "pre-commit: .graphify_python missing — skipping graph update." >&2
else
  echo "pre-commit: updating knowledge graph..."
  GRAPHIFY_PYTHON="$(cat "$REPO_ROOT/graphify-out/.graphify_python")"

  # Code files staged for this commit (added/copied/modified/renamed).
  STAGED_CODE="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(py|sh|ts|js|go|rs|java|rb|cs|cpp|c)$' || true)"

  if [[ -z "$STAGED_CODE" ]]; then
    echo "pre-commit: no code file changes — skipping graph update."
  else
    FILE_COUNT=$(echo "$STAGED_CODE" | wc -l | tr -d ' ')
    echo "pre-commit: $FILE_COUNT changed code file(s); rebuilding full code graph..."

    cd "$REPO_ROOT"

    # Capture graphify's status via a sentinel so the formatting pipe cannot
    # swallow failures. Do not use --force: graphify itself decides whether a
    # shrink corresponds to explicit source deletion.
    GRAPHIFY_OK_FILE="$(mktemp)"
    trap 'rm -f "$GRAPHIFY_OK_FILE"' EXIT
    {
      if GRAPHIFY_NO_TIPS=1 "$GRAPHIFY_PYTHON" -m graphify update .; then
        echo "0" > "$GRAPHIFY_OK_FILE"
      else
        echo "$?" > "$GRAPHIFY_OK_FILE"
      fi
    } 2>&1 | sed 's/^/  /'
    GRAPHIFY_OK="$(cat "$GRAPHIFY_OK_FILE")"

    if [[ "$GRAPHIFY_OK" -ne 0 ]]; then
      echo "pre-commit: graphify update failed — skipping graph staging." >&2
    else
      # update generates graph.html even when this repository does not track
      # it. Avoid leaving an unrelated multi-megabyte untracked file behind.
      if git ls-files --error-unmatch graphify-out/graph.html >/dev/null 2>&1; then
        git add "$REPO_ROOT/graphify-out/graph.html"
      else
        rm -f "$REPO_ROOT/graphify-out/graph.html"
      fi

      # Stage every tracked artifact the canonical update can modify, but only
      # after it succeeds so graph.json/report/labels cannot drift apart.
      git add "$REPO_ROOT/graphify-out/graph.json" \
              "$REPO_ROOT/graphify-out/GRAPH_REPORT.md" \
              "$REPO_ROOT/graphify-out/.graphify_labels.json" \
              "$REPO_ROOT/graphify-out/.graphify_root" \
              "$REPO_ROOT/graphify-out/manifest.json" 2>/dev/null || true
      echo "pre-commit: graphify-out/ changes staged."
    fi
  fi
fi
