+pub(crate) fn render_model_picker(
+    picker: &ModelPickerState,
+    area: Rect,
+    buf: &mut Buffer,
+    no_color: bool,
+) {
+    let modal = centered_rect(64, 24, area);
+    Clear.render(modal, buf);
+    let outer = Block::default()
+        .borders(Borders::ALL)
+        .title("Select model · Tab switches pane · Enter selects · Esc cancels")
+        .border_style(
+            Style::default()
+                .fg(Color::Cyan)
+                .add_modifier(Modifier::BOLD),
+        );
+    let inner = outer.inner(modal);
+    outer.render(modal, buf);
+    let panes = Layout::default()
+        .direction(Direction::Vertical)
+        .constraints([Constraint::Percentage(40), Constraint::Percentage(60)])
+        .split(inner);
+    let provider_lines = picker
+        .catalogs
+        .iter()
+        .enumerate()
+        .map(|(index, (name, _))| {
+            selectable_line(
+                name,
+                index == picker.provider_index,
+                picker.focus == ModelPickerFocus::Providers,
+            )
+        })
+        .collect::<Vec<_>>();
+    Paragraph::new(provider_lines)
+        .block(picker_block(
+            "Providers",
+            picker.focus == ModelPickerFocus::Providers,
+        ))
+        .render(panes[0], buf);
+    let model_lines = picker
+        .catalogs
+        .get(picker.provider_index)
+        .map(|(_, models)| {
+            models
+                .iter()
+                .enumerate()
+                .map(|(index, model)| {
+                    selectable_line(
+                        model,
+                        index == picker.model_index,
+                        picker.focus == ModelPickerFocus::Models,
+                    )
+                })
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    Paragraph::new(model_lines)
+        .block(picker_block(
+            "Models",
+            picker.focus == ModelPickerFocus::Models,
+        ))
+        .render(panes[1], buf);
+    if no_color {
+        for y in modal.y..modal.bottom() {
+            for x in modal.x..modal.right() {
+                buf[(x, y)].set_fg(Color::Reset).set_bg(Color::Reset);
+            }
+        }
+    }
+}
+
+fn picker_block(title: &'static str, focused: bool) -> Block<'static> {
+    Block::default()
+        .borders(Borders::ALL)
+        .title(title)
+        .border_style(if focused {
+            Style::default()
+                .fg(Color::Yellow)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(Color::DarkGray)
+        })
+}
+
+fn selectable_line(text: &str, selected: bool, focused: bool) -> Line<'static> {
+    let prefix = if selected { "▶ " } else { "  " };
+    let style = if selected && focused {
+        Style::default()
+            .fg(Color::Black)
+            .bg(Color::Yellow)
+            .add_modifier(Modifier::BOLD)
+    } else if selected {
+        Style::default()
+            .fg(Color::Cyan)
+            .add_modifier(Modifier::BOLD)
+    } else {
+        Style::default()
+    };
+    Line::styled(format!("{prefix}{}", sanitize(text)), style)
+}
