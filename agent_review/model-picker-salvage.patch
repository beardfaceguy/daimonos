+async fn discover_model_catalogs(
+    llm: &dyn providers::LlmProvider,
+    agent: &agent_env::AgentEnv,
+    effective_provider: &str,
+    effective_model: &str,
+) -> Vec<(String, Vec<String>)> {
+    let mut catalogs = if models_discovery_disabled() {
+        Vec::new()
+    } else {
+        tokio::time::timeout(std::time::Duration::from_secs(5), llm.list_model_catalogs())
+            .await
+            .ok()
+            .flatten()
+            .unwrap_or_default()
+    };
+    if catalogs.is_empty() {
+        catalogs.push((effective_provider.to_string(), agent.models.clone()));
+    }
+    let current_slug = effective_model
+        .strip_prefix(&format!("{effective_provider}:"))
+        .unwrap_or(effective_model);
+    if let Some((_, models)) = catalogs
+        .iter_mut()
+        .find(|(name, _)| name == effective_provider)
+    {
+        if !models.iter().any(|model| model == current_slug) {
+            models.insert(0, current_slug.to_string());
+        }
+    } else {
+        catalogs.insert(
+            0,
+            (
+                effective_provider.to_string(),
+                vec![current_slug.to_string()],
+            ),
+        );
+    }
+    catalogs
+}
+
+fn flatten_model_catalogs(catalogs: &[(String, Vec<String>)], current: &str) -> Vec<String> {
+    let multi = catalogs.len() > 1;
+    let mut models = Vec::new();
+    for (provider, slugs) in catalogs {
+        for slug in slugs {
+            let model = if multi {
+                format!("{provider}:{slug}")
+            } else {
+                slug.clone()
+            };
+            if !models.contains(&model) {
+                models.push(model);
+            }
+        }
+    }
+    if !models.iter().any(|model| model == current) {
+        models.insert(0, current.to_string());
+    }
+    models
+}
