+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ModelPickerFocus {
+    Providers,
+    Models,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ModelPickerState {
+    pub catalogs: Vec<(String, Vec<String>)>,
+    pub provider_index: usize,
+    pub model_index: usize,
+    pub focus: ModelPickerFocus,
+}
+
+impl ModelPickerState {
+    fn new(catalogs: Vec<(String, Vec<String>)>, current: &str) -> Self {
+        let current_slug = current.split_once(':').map_or(current, |(_, slug)| slug);
+        let provider_index = catalogs
+            .iter()
+            .position(|(provider, models)| {
+                current.starts_with(&format!("{provider}:"))
+                    || models.iter().any(|model| model == current_slug)
+            })
+            .unwrap_or(0);
+        let model_index = catalogs
+            .get(provider_index)
+            .and_then(|(_, models)| models.iter().position(|model| model == current_slug))
+            .unwrap_or(0);
+        Self {
+            catalogs,
+            provider_index,
+            model_index,
+            focus: ModelPickerFocus::Providers,
+        }
+    }
+
+    fn move_up(&mut self) {
+        let index = match self.focus {
+            ModelPickerFocus::Providers => &mut self.provider_index,
+            ModelPickerFocus::Models => &mut self.model_index,
+        };
+        *index = index.saturating_sub(1);
+        if self.focus == ModelPickerFocus::Providers {
+            self.model_index = 0;
+        }
+    }
+
+    fn move_down(&mut self) {
+        match self.focus {
+            ModelPickerFocus::Providers => {
+                self.provider_index =
+                    (self.provider_index + 1).min(self.catalogs.len().saturating_sub(1));
+                self.model_index = 0;
+            }
+            ModelPickerFocus::Models => {
+                let last = self
+                    .catalogs
+                    .get(self.provider_index)
+                    .map_or(0, |(_, models)| models.len().saturating_sub(1));
+                self.model_index = (self.model_index + 1).min(last);
+            }
+        }
+    }
+
+    fn toggle_focus(&mut self) {
+        self.focus = match self.focus {
+            ModelPickerFocus::Providers => ModelPickerFocus::Models,
+            ModelPickerFocus::Models => ModelPickerFocus::Providers,
+        };
+    }
+
+    fn selected_model(&self) -> Option<String> {
+        if self.focus == ModelPickerFocus::Providers {
+            return None;
+        }
+        let (provider, models) = self.catalogs.get(self.provider_index)?;
+        let model = models.get(self.model_index)?;
+        Some(if self.catalogs.len() > 1 {
+            format!("{provider}:{model}")
+        } else {
+            model.clone()
+        })
+    }
+}
