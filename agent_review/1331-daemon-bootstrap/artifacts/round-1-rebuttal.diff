+        || metadata.permissions().mode() & 0o077 != 0 {
+        return Err(io::Error::new(PermissionDenied, "metadata is not owner-only regular file"));
+    }
+    let mut file = OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW).open(path)?;
