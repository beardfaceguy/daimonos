CONFIG_SYSVIPC=y
CONFIG_CGROUPS=y
# No loadable modules — everything built-in for minimal image
# CONFIG_MODULES is not set
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# Networking (required for SSH)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=y
# CONFIG_WIRELESS is not set

# ACPI (required for AWS Nitro hardware discovery)
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y

# PCI bus
CONFIG_PCI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y

# Device management
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Block devices
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y

# Xen support for EC2 t2/m4 instances
CONFIG_XEN=y
CONFIG_XEN_PV=y
CONFIG_XEN_BLKDEV_FRONTEND=y
CONFIG_XEN_NETDEV_FRONTEND=y

# Network drivers — virtio only
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
# CONFIG_NE2K_PCI is not set
# CONFIG_8139CP is not set
# CONFIG_WLAN is not set

# No GPU/display
# CONFIG_DRM is not set
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y

# No sound
# CONFIG_SOUND is not set

# No USB
# CONFIG_USB is not set

# No input devices beyond basic keyboard for serial
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_MOUSE is not set

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Virtio infrastructure
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_MMIO=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_CONSOLE=y

# Filesystem
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Crypto (needed by SSH)
CONFIG_CRYPTO=y

# Misc
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_UNWINDER_FRAME_POINTER=y

# Clocksource (Nitro uses TSC/HPET)
CONFIG_X86_TSC=y

# DHCP needs packet socket
CONFIG_PACKET=y

# NVMe support for AWS EC2 Nitro instances
CONFIG_BLK_DEV_NVME=y

# Ena driver for AWS EC2 networking
CONFIG_ENA_ETHERNET=y
