# Architecture
BR2_x86_64=y

# Toolchain — musl for minimal libc
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_12=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# System
BR2_TARGET_GENERIC_HOSTNAME="daimonos"
BR2_TARGET_GENERIC_ISSUE="Daimonos Agent OS"
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DAIMONOS_PATH)/overlay"
BR2_ROOTFS_DEVICE_TABLE="$(BR2_EXTERNAL_DAIMONOS_PATH)/board/daimonos/permissions.txt"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_DAIMONOS_PATH)/board/daimonos/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DAIMONOS_PATH)/board/daimonos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DAIMONOS_PATH)/board/daimonos/post-image.sh"

# Linux kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.27"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_DAIMONOS_PATH)/board/daimonos/linux.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Bootloader — GRUB2 for BIOS boot
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# Packages — only what daimonos needs
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_GIT_HTTP=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y

# Node.js + npm (for running agent CLIs on-instance benchmarks)
BR2_PACKAGE_NODEJS=y
BR2_PACKAGE_NODEJS_NPM=y

# Filesystem tools for first-boot resize (CLA-216)
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for image generation
BR2_PACKAGE_HOST_GENIMAGE=y

# Don't enforce hashes for custom kernel versions
# BR2_DOWNLOAD_FORCE_CHECK_HASHES is not set
