+        .unwrap();
+    assert_eq!(output.exit_code, 0, "{}", output.output);
+    assert_eq!(output.output["commits"][0], f.last);
+}
+
+#[tokio::test]
+async fn serialized_errors_respect_the_response_byte_cap() {
