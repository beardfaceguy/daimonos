+    _,commit=repository(workspace)
+    (workspace/"daimonos.toml").write_text("[git_read]\nstrict_pinning=true\n[logging]\nenabled=false\n[analytics]\nenabled=false\n")
+    source_tests=str(Path(__file__).resolve().parent)
