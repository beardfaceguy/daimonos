+    // --- review round 1: terminal history shapes (ADR-036 Decision 8) ---
+
+    fn response(content: Vec<ContentBlock>, stop: crate::providers::StopReason) -> LlmResponse {
+        LlmResponse {
+            retryable: false,
+            content,
+            stop_reason: stop,
+            error_message: None,
+            context_overflow: false,
+            usage: Usage::default(),
+        }
+    }
