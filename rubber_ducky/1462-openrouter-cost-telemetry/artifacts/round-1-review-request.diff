@@ -572,9 +572,17 @@ fn parse_usage(usage: &Value) -> Usage {
         thinking_bytes: 0,
         cache_read,
         cache_write,
-        // OpenRouter does not return cost in the usage object; left at zero.
-        // Fetch from /api/v1/generation?id={id} if per-run cost is needed.
