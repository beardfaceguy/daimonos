/target
tests/target/
__pycache__/
*.pyc
# benchmark run data stays local; committed writeups (*.md) are the record
/benchmarks/results/*
!/benchmarks/results/*.md
/benchmarks/workspace/
/benchmarks/server-bench/results/
claude_api_key.env
.env
.env.*
*.log
.DS_Store

# Ad-hoc dev/provisioning artifacts (AWS instance dumps, etc.)
instance_contents_log.txt

# Derived indexes: machine-local, regenerable, and large (~113 MB combined).
# Generated index output must never be tracked. The tracked graphify graph.json
# used to block routine `git checkout` because a 6 MB file no human edits still
# showed as modified, and the pre-commit hook re-staged it on every commit.
#
# graphify-out/ is still produced -- it is the substrate KGL indexes -- but only
# as local state. See docs/adr/012-graphify-as-kgl-substrate.md.
.repowise/
.repowise-workspace/
.repowise-workspace.yaml
graphify-out/

# Editor/agent config that repowise regenerates on every `repowise update`.
# .mcp.json and .vscode/mcp.json hardcode an absolute workspace path, so they
# are per-machine by construction: committing them ships one developer's home
# directory to everyone else and leaves the tree dirty after every commit.
# `repowise init` regenerates both. The lock file is per-process runtime state.
#
# .claude/CLAUDE.md is 84/89 lines auto-generated, and its generated block
# embeds the indexed commit plus drifting health scores -- a 3-line diff after
# every commit. Nothing was written above the marker, and AGENTS.md already is
# this repo's tracked, hand-written agent instruction file, so there is nothing
# to preserve. .vscode/extensions.json IS tracked: portable and stable.
.mcp.json
.vscode/mcp.json
.claude/scheduled_tasks.lock
.claude/CLAUDE.md

# KGL session state (per-machine SQLite database)
.kgl/

# Daimonos local session/snapshot state (per-machine, may contain stale lockfiles)
.daimonos/

# Local Vikunja reconciliation log (per-developer; offline progress tracking)
VIKUNJA_TRACKING.md

# Third-party reference clone (analyzed for project #178; not our code)
ponytail/

# Benchmark baseline/post binaries (large, per-machine; rebuild from git_commit in benchmarks/optimization-lineage.json)
bench/bin/
benchmarks/bin/

# Local dotenv-style secrets/config loaded by daimonos at startup
agent.env

# Android/Gradle local state
/android/.gradle/
/android/.idea/
/android/local.properties
/android/**/build/
*.jks
*.keystore

